# ==============================================================================
# COSMOGEEK CERTIFICATE QR VERIFICATION & GENERATION SYSTEM CONFIGURATION
# ==============================================================================

# 1. FRONTEND & QR VERIFICATION BASE URL CONFIGURATION
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL / PUBLIC_BASE_URL / APP_URL:
# This base URL is embedded into all generated certificate QR codes and verification links.
#
# FOR TESTING FROM A MOBILE PHONE ON THE SAME WI-FI:
# Run 'ipconfig' on Windows PowerShell to find your computer's IPv4 address.
# Example: If your IPv4 address is 192.168.1.5, set:
# NEXT_PUBLIC_APP_URL="http://192.168.1.5:3000"
#
# FOR PRODUCTION / CLOUD DEPLOYMENT:
# Set this to your public HTTPS domain:
# NEXT_PUBLIC_APP_URL="https://verify.cosmogeek.com"
#
# NOTE: If left as "http://localhost:3000", scanning QR codes from a phone will fail
# with ERR_CONNECTION_REFUSED because phones cannot reach your computer's localhost.

APP_BASE_URL="http://192.168.1.5:3000"
NEXT_PUBLIC_APP_URL="http://192.168.1.5:3000"
PUBLIC_BASE_URL="http://192.168.1.5:3000"
APP_URL="http://192.168.1.5:3000"

# Optional: Separate Backend API URL (leave empty if backend and frontend are on the same port 3000)
# VITE_API_URL="http://192.168.1.5:3000"
# NEXT_PUBLIC_API_URL="http://192.168.1.5:3000"

# 2. MONGODB ATLAS DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# MONGODB_URI: Connection string for MongoDB Atlas.
# Target Database: certificateDB
# Target Collection: students
# Example: mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/certificateDB?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<cosmosdigital44_db_user>:<AIobXTgkO3UkakXJ>@<cluster-url>.mongodb.net/certificateDB?retryWrites=true&w=majority"

# 3. SERVER PORT & HOST
# ------------------------------------------------------------------------------
PORT=3000

# 4. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="Admin@Cosmogeek2026!"
SESSION_SECRET="cosmogeek-ultra-secure-session-key-change-in-production-2026"

# 4. STORAGE DIRECTORIES (relative to project root)
# ------------------------------------------------------------------------------
STORAGE_DIR="storage/certificates"
TEMPLATES_DIR="templates"
DATABASE_FILE="data/certificates.sqlite"

# 5. OPTIONAL GEMINI API KEY (if AI studio features are enabled)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
